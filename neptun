using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Text.RegularExpressions;
using System.Threading.Tasks;

namespace Common
{
    public class Ingreadient
    {
        public string Name { get; set; }
        public int Count { get; set; }

        public string Unit { get; set; }

        public Ingreadient(string name, int count, string unit)
        {
            Name = name;
            Count = count;
            Unit = unit;
        }

        public Ingreadient(string uj) {

            var match = Regex.Match(uj.Trim(), @"(\d+)\s+(\S+)\s+(.+)$");

            if (!match.Success) {
                throw new ArgumentException("Nem jó a formátum!!!");
            }

            Count = int.Parse(match.Groups[1].Value);
            Unit = match.Groups[2].Value;
            Name = match.Groups[3].Value;
        }



        public static Ingreadient GetRandom() {
            Random rnd = new Random();
            int rndC = rnd.Next(0, 100);
            return new Ingreadient("kurva", rndC, "anyád");
        }

        public override string ToString(){
            return $"{Name}: {Count} {Unit}";
        }
    }
}
