using Common;

namespace Tests;

public class Test1
{
    [Fact]
    public void TestIngreadients()
    {
        RecipeBook book = new RecipeBook();

        book.Add("69 kurva vagy");
        book.Add("420 ribanc vagy");

        Assert.Equal(2, book.GetIngreadients().Count());

        Assert.Throws<ArgumentException>(() => book.Add("kurva anyád"));
        Assert.Throws<ArgumentException>(() => book.Add("anyád 15"));
    }
}
