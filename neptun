namespace Tests;
using Common;
using System;


public class TrivialIngradientSourceTests
{
    [Fact]
    public void TestCount()
    {
        var source = new TrivialIngreadientSource()
        {
            N = 8
        };

        var ingreadients = source.GetIngreadients();
        int count = ingreadients.Count();

        Assert.Equal(8, count);
    }
}
