using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Common
{
    public class TrivialIngreadientSource : IIngreadientSource
    {
        public int N { get; set; } = 3;
        
        public IEnumerable<Ingreadient> GetIngreadients() {
            for (int i = 0; i < N; i++) {
                yield return Ingreadient.GetRandom();
            }
        }
    }
}
