using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Common
{
    public class RecipeBook : IIngreadientSource
    {
        public List<Ingreadient> lista = new List<Ingreadient>();

        public IEnumerable<Ingreadient> GetIngreadients() { 
            return lista;
        }

        public void Add(string uj) {
            lista.Add(new Ingreadient(uj));
        }
    }
}
