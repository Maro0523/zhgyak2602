using Common;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace ConsoleApplication
{
    public class ConsoleApplication
    {
        static void Main(string[] args) {
            var generator = new SimpleGenerator() { ValueToGenerate = true };

            ShowBools(generator, 5);

            var generator2 = new PatternGenerator();
            ShowBools(generator2, 15);
        }
        static void ShowBools(IBoolSource bools, int N) { 
            
            int trueCount = bools.GetBools(N).Count(b => b);
            Console.WriteLine($"True-k száma: {trueCount}");
        }
    }
}
