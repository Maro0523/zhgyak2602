namespace ConsoleApp
{
    public class ConsoleApp
    {
        static void Main(string[] args) {
            TrivialPersonSource en = new TrivialPersonSource(3);

            AdvancedPersonSource te = new AdvancedPersonSource();
            te.Add("lurva", 69, 133);
            te.Add("durva", 31, 54);
            te.Add("rurva", 50, 233);
            te.Add("kurva", 91, 123);

            
            PrintPersons(te, en);
        }

        static void PrintPersons(IPersonSource te, IPersonSource en) { 
            foreach (var item in te.GetPersons()){ 
                Console.WriteLine(item);
            }
            foreach (var item2 in en.GetPersons())
            {
                Console.WriteLine(item2);
            }
        }
    }
