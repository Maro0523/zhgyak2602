using Common;
using System.Linq;

namespace Tests;

public class TrivialPersonSourceTests
{
    [Fact]
    public void TestCount()
    {
        var source = new TrivialPersonSource(12);

        var persons = source.GetPersons();

        int count = persons.Count();

        Assert.Equal(12, count);
    }
}
