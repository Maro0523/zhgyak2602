using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Common
{
    public class ClassRoom
    {
        private List<Person> lista = new List<Person>();

        public void Add(Person person) {
            lista.Add(person);
        }

        public int Count() {
            return lista.Count();
        }

        public double GetAverageAge() { 
            double avg = lista.Average(p => p.Age);
            return avg;
        }

        public int GetTallestPerson()
        {
            int legmagasabb = lista.Max(p => p.Height);
            return legmagasabb;
        }
    }
}
