using Common;

namespace Tests;

public class ModifierTests
{
    [Fact]
    public void TestGrowPerson()
    {
        Person tesztelő = new Person("Teszt Elek", 20, 180);
        Assert.Equal(180, tesztelő.Height);

        var mennyivel = new PersonGrower() { N = 5};

        mennyivel.Modify(tesztelő);
        Assert.Equal(185, tesztelő.Height);
    }
}
