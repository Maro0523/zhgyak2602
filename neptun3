using Common;

namespace Tests;

public class ClassRoomTests
{
    [Fact]
    public void TestAddition()
    {
        var cRoom = new ClassRoom();

        for (int i = 0; i < 3; i++) {
            cRoom.Add(Person.GetMe());
        }
        int count = cRoom.Count();

        Assert.Equal(3, count);
    }

    [Fact]
    public void TestHeightinClass() { 
        var cRoom = new ClassRoom();
        Person p1 = new Person("buzi", 15, 170);
        Person p2 = new Person("buzi2", 15, 150);
        Person p3 = new Person("buzi3", 15, 165);
        cRoom.Add(p1);
        cRoom.Add(p2);
        cRoom.Add(p3);

        Assert.Equal(170, cRoom.GetTallestPerson());

        var grower = new PersonGrower() { N = 10 };

        grower.Modify(p3);

        Assert.Equal(175, cRoom.GetTallestPerson());
    }
}
